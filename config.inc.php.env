<?php
/*
  [!] DO NOT EDIT THIS FILE [!]

  This file is used to get the
  iLO access credentials via
  environment variables.
  Used when deploying with Docker.
*/

require_once __DIR__ . '/lib/env-secrets.php';

$ILO_HOST = ifc_env('ILO_HOST');
$ILO_USERNAME = ifc_env('ILO_USERNAME');
$ILO_PASSWORD = ifc_env('ILO_PASSWORD');

$MINIMUM_FAN_SPEED = getenv('MINIMUM_FAN_SPEED') ?: 10; // Default to 10% if not provided

$AUTO_DAEMON = filter_var(getenv('AUTO_DAEMON') ?: 'true', FILTER_VALIDATE_BOOLEAN); // Default to true

function get_servers() {
    $serversFile = '/data/servers.json';
    if (file_exists($serversFile)) {
        $raw = file_get_contents($serversFile);
        $data = json_decode($raw, true);
        if (json_last_error() !== JSON_ERROR_NONE) {
            $msg = 'servers.json: invalid JSON (' . json_last_error_msg() . ')';
            if (PHP_SAPI === 'cli') {
                fwrite(STDERR, $msg . "\n");
                exit(1);
            }
            trigger_error($msg, E_USER_WARNING);

            return [];
        }
        if (!is_array($data) || count($data) === 0) {
            $msg = 'servers.json: must be a non-empty JSON array';
            if (PHP_SAPI === 'cli') {
                fwrite(STDERR, $msg . "\n");
                exit(1);
            }
            trigger_error($msg, E_USER_WARNING);

            return [];
        }

        return array_map('ifc_resolve_server_secrets', $data);
    }
    return [[
        'id'             => 'server1',
        'name'           => 'Server',
        'host'           => ifc_env('ILO_HOST'),
        'username'       => ifc_env('ILO_USERNAME'),
        'password'       => ifc_env('ILO_PASSWORD'),
        'minimumFanSpeed' => (int)(ifc_env('MINIMUM_FAN_SPEED') ?: '10'),
    ]];
}

?>

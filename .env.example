# iLO Credentials
ILO_HOST=your-ilo-ip
ILO_USERNAME=Administrator
ILO_PASSWORD=your-password

# Fan Settings
MINIMUM_FAN_SPEED=10

# Auto Daemon (set to false to disable automatic fan control)
AUTO_DAEMON=true

# Proxmox (optional — disk temps for UI + fan daemon)
# API token: user@pam!tokenid=secret (without PVEAPIToken= prefix)
PROXMOX_HOST=192.168.1.10
PROXMOX_NODE=waw01-pve
PROXMOX_PORT=8006
PROXMOX_API_TOKEN=user@pam!ifc=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

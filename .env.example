# iLO Credentials (use VAR or VAR_FILE pointing at a file with the value)
ILO_HOST=your-ilo-ip
ILO_USERNAME=Administrator
ILO_PASSWORD=your-password
# ILO_PASSWORD_FILE=/run/secrets/ilo_password

# Fan Settings
MINIMUM_FAN_SPEED=10

# Auto Daemon (set to false to disable automatic fan control)
AUTO_DAEMON=true

# Proxmox thermal agent (optional — disk + host CPU temps for UI + fan daemon)
# Install ilo-fans-agent-pve on the PVE node; listen on SDN IP reachable from IFC
PROXMOX_AGENT_URL=http://172.16.0.10:9847
PROXMOX_AGENT_TOKEN=your-agent-bearer-token
# PROXMOX_AGENT_TOKEN_FILE=/run/secrets/proxmox_agent_token
